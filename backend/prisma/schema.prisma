generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                    String    @id @default(uuid())
  email                 String    @unique
  password              String
  name                  String?
  role                  String    @default("MERCHANT") // MERCHANT, ADMIN, CUSTOMER
  kycStatus             String    @default("PENDING") // PENDING, APPROVED, REJECTED, UNDER_REVIEW
  verified              Boolean   @default(false)
  onboardingStep        String    @default("COMPLETED") // COMPLETED, BUSINESS_INFO, KYC_UPLOAD, KYC_PENDING
  verificationToken     String?
  verificationCode       String?
  verificationCodeExpiry DateTime?
  resetToken            String?
  resetTokenExpiry      DateTime?
  twoFactorEnabled      Boolean   @default(false)
  twoFactorSecret       String?
  twoFactorBackupCodes   String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  merchant              Merchant?
  customer              Customer?
  notifications         Notification[]
  sessions              Session[]

  @@index([email])
}

model Merchant {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id])
  businessName    String
  businessType    String   // INDIVIDUAL, BUSINESS
  businessEmail   String?
  phoneNumber     String
  businessAddress String?
  onboardingStep  String   @default("COMPLETED") // COMPLETED, BUSINESS_INFO, KYC_UPLOAD, KYC_PENDING
  status          String   @default("PENDING") // PENDING, SANDBOX_LIVE, APPROVED, SUSPENDED, REVERIFICATION_REQUIRED
  profilePicture  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  transactions    Transaction[]
  withdrawals     Withdrawal[]
  kycDocuments    KYCDocument[]
  paymentLinks    PaymentLink[]
  apiKeys         ApiKey[] @relation("MerchantApiKeys")
  settlements     Settlement[] @relation("MerchantSettlements")
  webhooks        Webhook[] @relation("MerchantWebhooks")
  notifications   Notification[]
}

model Customer {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id])
  name        String
  phone       String
  address     String?
  balance     Float    @default(0)
  kycStatus   String   @default("PENDING") // PENDING, APPROVED, REJECTED, UNDER_REVIEW
  profilePicture String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  transactions     Transaction[]
  sentTransfers    CustomerTransfer[] @relation("SentTransfers")
  receivedTransfers CustomerTransfer[] @relation("ReceivedTransfers")
  paymentMethods   PaymentMethod[]
  disputes         Dispute[]
  supportTickets   SupportTicket[]
  kycDocuments     CustomerKYCDocument[]
  withdrawals      CustomerWithdrawal[]
}

model Transaction {
  id              String          @id @default(uuid())
  merchantId      String
  merchant        Merchant        @relation(fields: [merchantId], references: [id])
  customerId      String?
  customer        Customer?       @relation(fields: [customerId], references: [id])
  amount          Float
  currency        String          @default("SLE")
  paymentMethod   String // ORANGE_MONEY, AFRIMONEY, QMONEY
  status          String @default("PENDING") // PENDING, SUCCESSFUL, FAILED, REFUNDED, PROCESSING
  description     String?
  reference       String          @unique
  metadata        String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  refund          Refund?

  @@index([merchantId])
  @@index([customerId])
  @@index([status])
  @@index([createdAt])
}

model PaymentLink {
  id          String   @id @default(uuid())
  merchantId  String
  merchant    Merchant @relation(fields: [merchantId], references: [id])
  title       String
  description String?
  amount      Float
  currency    String   @default("SLE")
  active      Boolean  @default(true)
  expiresAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([merchantId])
}

model Settlement {
  id          String   @id @default(uuid())
  merchantId  String
  merchant    Merchant @relation("MerchantSettlements", fields: [merchantId], references: [id])
  amount      Float
  currency    String   @default("SLE")
  status      String   @default("PENDING")
  mobileMoneyProvider String // ORANGE_MONEY, AFRIMONEY, QMONEY
  mobileNumber String
  instant     Boolean  @default(false)
  instantFee  Float    @default(0)
  settledAt   DateTime?
  createdAt   DateTime @default(now())

  @@index([merchantId])
}

model Refund {
  id              String      @id @default(uuid())
  transactionId   String      @unique
  transaction     Transaction @relation(fields: [transactionId], references: [id])
  amount          Float
  reason          String?
  status          String      @default("PENDING")
  processedAt     DateTime?
  createdAt       DateTime    @default(now())

  @@index([transactionId])
}

model KYCDocument {
  id          String   @id @default(uuid())
  merchantId  String
  merchant    Merchant @relation(fields: [merchantId], references: [id])
  documentType String  // ID_CARD, PASSPORT, BUSINESS_CERT, PROOF_OF_ADDRESS, UBO_DISCLOSURE
  documentUrl  String
  status      String @default("PENDING") // PENDING, APPROVED, REJECTED, UNDER_REVIEW, NEEDS_INFO
  rejectionReason String?
  adminComment String?
  expiryDate  DateTime?
  submittedAt DateTime @default(now()) // When document was submitted for review
  reviewedAt  DateTime?
  metadata    String? // OCR extraction results and validation data
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([merchantId])
}

model CustomerKYCDocument {
  id          String   @id @default(uuid())
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id])
  documentType String  // ID_CARD, PASSPORT, PROOF_OF_ADDRESS
  documentUrl  String
  status      String @default("PENDING") // PENDING, APPROVED, REJECTED, UNDER_REVIEW, NEEDS_INFO
  rejectionReason String?
  adminComment String?
  expiryDate  DateTime?
  submittedAt DateTime @default(now()) // When document was submitted for review
  reviewedAt  DateTime?
  metadata    String? // OCR extraction results and validation data
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([customerId])
}

model Withdrawal {
  id          String   @id @default(uuid())
  merchantId  String
  merchant    Merchant @relation(fields: [merchantId], references: [id])
  amount      Float
  currency    String   @default("SLE")
  mobileMoneyProvider String // ORANGE_MONEY, AFRIMONEY, QMONEY
  mobileNumber String
  status      String   @default("PENDING")
  processedAt DateTime?
  rejectionReason String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([merchantId])
}

model CustomerWithdrawal {
  id          String   @id @default(uuid())
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id])
  amount      Float
  currency    String   @default("SLE")
  mobileMoneyProvider String // ORANGE_MONEY, AFRIMONEY, QMONEY
  mobileNumber String
  status      String   @default("PENDING")
  processedAt DateTime?
  rejectionReason String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([customerId])
}

model Notification {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  merchantId String?
  merchant   Merchant? @relation(fields: [merchantId], references: [id])
  type       String
  title      String
  message    String
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([read])
  @@index([merchantId])
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
}

model WebhookLog {
  id        String   @id @default(uuid())
  merchantId String
  eventType String
  payload   String
  response  String?
  status    String
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([merchantId])
  @@index([eventType])
}

model ApiKey {
  id          String   @id @default(uuid())
  merchantId  String
  merchant    Merchant @relation("MerchantApiKeys", fields: [merchantId], references: [id])
  name        String
  publicKey   String   @unique
  secretKey   String
  webhookSecret String
  isActive    Boolean  @default(true)
  lastUsed    DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([merchantId])
}

model Webhook {
  id          String   @id @default(uuid())
  merchantId  String
  merchant    Merchant @relation("MerchantWebhooks", fields: [merchantId], references: [id])
  url         String
  events      String
  description String?
  secret      String
  status      String   @default("active") // active, paused
  lastTriggered DateTime?
  successRate Float    @default(100)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([merchantId])
}

model CustomerTransfer {
  id              String   @id @default(uuid())
  senderId        String
  sender          Customer @relation("SentTransfers", fields: [senderId], references: [id])
  receiverId      String
  receiver        Customer @relation("ReceivedTransfers", fields: [receiverId], references: [id])
  amount          Float
  currency        String   @default("SLE")
  description     String?
  status          String   @default("PENDING") // PENDING, COMPLETED, FAILED, REVERSED
  reference       String   @unique
  reversedAt      DateTime?
  reversalReason  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([senderId])
  @@index([receiverId])
  @@index([status])
}

model PaymentMethod {
  id          String   @id @default(uuid())
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id])
  type        String   // ORANGE_MONEY, AFRIMONEY, QMONEY
  phoneNumber String
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([customerId])
}

model Dispute {
  id              String   @id @default(uuid())
  customerId      String
  customer        Customer @relation(fields: [customerId], references: [id])
  transactionId   String?
  transferId      String?
  title           String
  description     String
  status          String   @default("OPEN") // OPEN, UNDER_REVIEW, RESOLVED, CLOSED
  resolution      String?
  resolvedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([customerId])
  @@index([status])
}

model SupportTicket {
  id          String   @id @default(uuid())
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id])
  subject     String
  message     String
  status      String   @default("OPEN") // OPEN, IN_PROGRESS, RESOLVED, CLOSED
  priority    String   @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  responses   String?
  resolvedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([customerId])
  @@index([status])
}

model Subscription {
  id          String   @id @default(uuid())
  merchantId  String
  customerId  String
  amount      Float
  currency    String   @default("SLE")
  interval    String   // DAILY, WEEKLY, MONTHLY, YEARLY
  status      String   @default("ACTIVE") // ACTIVE, PAUSED, CANCELLED, EXPIRED
  nextBilling DateTime
  lastPayment DateTime?
  metadata    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([merchantId])
  @@index([customerId])
  @@index([status])
}

model SplitPayment {
  id              String   @id @default(uuid())
  merchantId      String
  totalAmount     Float
  currency        String   @default("SLE")
  status          String   @default("PENDING") // PENDING, COMPLETED, FAILED
  reference       String   @unique
  expiresAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  splits          SplitPaymentPart[]

  @@index([merchantId])
  @@index([status])
}

model SplitPaymentPart {
  id              String       @id @default(uuid())
  splitPaymentId String
  splitPayment   SplitPayment @relation(fields: [splitPaymentId], references: [id])
  recipientId     String
  recipientType   String       // MERCHANT, CUSTOMER
  amount          Float
  status          String       @default("PENDING") // PENDING, COMPLETED, FAILED
  transactionId   String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([splitPaymentId])
  @@index([recipientId])
}

model Escrow {
  id              String   @id @default(uuid())
  merchantId      String
  customerId      String
  amount          Float
  currency        String   @default("SLE")
  status          String   @default("PENDING") // PENDING, FUNDED, RELEASED, REFUNDED, DISPUTED
  releaseCondition String?
  reference       String   @unique
  fundedAt        DateTime?
  releasedAt      DateTime?
  refundedAt      DateTime?
  metadata        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([merchantId])
  @@index([customerId])
  @@index([status])
}

model QRCode {
  id          String   @id @default(uuid())
  merchantId  String
  amount      Float?
  currency    String   @default("SLE")
  qrCodeData  String
  status      String   @default("ACTIVE") // ACTIVE, EXPIRED, DISABLED
  expiresAt   DateTime?
  scanCount   Int      @default(0)
  metadata    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([merchantId])
  @@index([status])
}

model Invoice {
  id          String   @id @default(uuid())
  merchantId  String
  customerId  String?
  invoiceNumber String @unique
  amount      Float
  currency    String   @default("SLE")
  status      String   @default("DRAFT") // DRAFT, SENT, PAID, OVERDUE, CANCELLED
  dueDate     DateTime?
  paidAt      DateTime?
  items       String   // JSON array of invoice items
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([merchantId])
  @@index([customerId])
  @@index([status])
}

model Referral {
  id          String   @id @default(uuid())
  referrerId  String
  refereeId   String?
  code        String   @unique
  status      String   @default("PENDING") // PENDING, COMPLETED
  reward      Float
  currency    String   @default("SLE")
  completedAt DateTime?
  createdAt   DateTime @default(now())

  @@index([referrerId])
  @@index([refereeId])
  @@index([code])
}

model LoyaltyReward {
  id          String   @id @default(uuid())
  customerId  String
  points      Int      @default(0)
  level       String   @default("BRONZE") // BRONZE, SILVER, GOLD, PLATINUM
  totalSpent  Float    @default(0)
  redeemed    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([customerId])
}

model PromoCode {
  id          String   @id @default(uuid())
  code        String   @unique
  description String?
  discountType String  // PERCENTAGE, FIXED_AMOUNT
  discountValue Float
  minAmount   Float?
  maxDiscount Float?
  usageLimit  Int?
  usedCount   Int      @default(0)
  validFrom   DateTime
  validUntil  DateTime
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([code])
  @@index([active])
}

model Currency {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  symbol      String
  rate        Float    @default(1.0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([code])
  @@index([active])
}

model BulkPayment {
  id          String   @id @default(uuid())
  merchantId  String
  totalAmount Float
  currency    String   @default("SLE")
  status      String   @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED
  fileUrl     String
  processedCount Int   @default(0)
  failedCount Int      @default(0)
  metadata    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([merchantId])
  @@index([status])
}

model ChatConversation {
  id          String   @id @default(uuid())
  userId      String?
  sessionId   String   @unique
  messages    String   // JSON array of messages
  status      String   @default("ACTIVE") // ACTIVE, CLOSED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([sessionId])
}
